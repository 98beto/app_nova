Project appnova {
  database_type: 'PostgreSQL'
  Note: 'Esquema conceptual simplificado de AppNova. La primera entrega implementa identidad y autenticacion.'
}

Enum user_gender {
  male
  female
  non_binary
  prefer_not_to_say
}

Enum user_role {
  user
  developer
  admin
}

Enum user_status {
  active
  suspended
  disabled
}

Enum developer_payment_status {
  pending
  paid
  failed
  refunded
}

Enum application_status {
  draft
  pending_review
  approved
  rejected
  unpublished
}

Enum payment_purpose {
  developer_activation
  application_purchase
}

Enum payment_provider {
  paypal
}

Enum payment_status {
  created
  approved
  completed
  failed
  denied
  refunded
}

Enum earning_status {
  pending
  available
  paid
  reversed
}

Enum promotion_discount_type {
  percentage
  fixed
}

Table users {
  id bigint [pk, increment]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  password varchar(255) [not null]
  avatar_path varchar(2048)
  gender user_gender [not null]
  birth_date date [not null]
  role user_role [not null, default: 'user']
  status user_status [not null, default: 'active']
  email_verified_at timestamptz
  remember_token varchar(100)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (role, status) [name: 'users_role_status_idx']
  }

  checks {
    `birth_date <= CURRENT_DATE` [name: 'users_birth_date_not_future']
  }

  Note: 'El registro publico admite roles user y developer. El rol admin se crea internamente.'
}

Table developer_profiles {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  company_name varchar(255) [not null]
  payment_status developer_payment_status [not null, default: 'pending']
  activated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `(payment_status IN ('paid', 'refunded') AND activated_at IS NOT NULL) OR (payment_status IN ('pending', 'failed') AND activated_at IS NULL)` [name: 'developer_profiles_payment_activated_at']
  }

  Note: 'user_id corresponde a un usuario con rol developer. El pago de activacion verificado actualiza payment_status y activated_at transaccionalmente. Los pagos se conservan en payments.'
}

Table categories {
  id bigint [pk, increment]
  name varchar(120) [not null, unique]
  slug varchar(140) [not null, unique]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    is_active [name: 'categories_active_idx']
  }
}

Table applications {
  id bigint [pk, increment]
  developer_id bigint [not null, note: 'Referencia developer_profiles.id, no users.id.']
  category_id bigint [not null]
  name varchar(255) [not null]
  slug varchar(255) [not null, unique]
  icon_path varchar(2048)
  description text [not null]
  minimum_age smallint [not null, default: 0]
  price decimal(12,2) [not null, default: 0]
  status application_status [not null, default: 'draft']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (developer_id, status) [name: 'applications_developer_status_idx']
    (category_id, status, published_at) [name: 'applications_store_listing_idx']
  }

  checks {
    `minimum_age BETWEEN 0 AND 18` [name: 'applications_minimum_age_range']
    `price >= 0` [name: 'applications_price_non_negative']
    `published_at IS NULL OR (status = 'approved' AND icon_path IS NOT NULL)` [name: 'applications_published_approval_data']
  }

  Note: 'Solo desarrolladores activados pueden enviar aplicaciones. Un administrador cambia directamente el estado. No se guarda historial de moderacion. Para aprobar se requiere icono y cuatro capturas, comprobadas transaccionalmente.'
}

Table application_screenshots {
  id bigint [pk, increment]
  application_id bigint [not null]
  image_path varchar(2048) [not null]
  position smallint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, position) [unique, name: 'application_screenshots_position_unique']
  }

  checks {
    `position BETWEEN 1 AND 4` [name: 'application_screenshots_position_range']
  }
}

Table payments {
  id bigint [pk, increment]
  user_id bigint [not null]
  application_id bigint
  purpose payment_purpose [not null]
  provider payment_provider [not null, default: 'paypal']
  provider_order_id varchar(255) [unique]
  provider_capture_id varchar(255) [unique]
  amount decimal(12,2) [not null]
  currency char(3) [not null]
  status payment_status [not null, default: 'created']
  provider_response json
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, status, created_at) [name: 'payments_user_history_idx']
    (application_id, status) [name: 'payments_application_status_idx']
    (purpose, status) [name: 'payments_purpose_status_idx']
  }

  checks {
    `amount >= 0` [name: 'payments_amount_non_negative']
    `currency = upper(currency)` [name: 'payments_currency_uppercase']
    `(status IN ('completed', 'refunded') AND paid_at IS NOT NULL) OR (status IN ('created', 'approved', 'failed', 'denied') AND paid_at IS NULL)` [name: 'payments_completed_at']
    `(purpose = 'application_purchase' AND application_id IS NOT NULL) OR (purpose = 'developer_activation' AND application_id IS NULL)` [name: 'payments_purpose_application']
  }

  Note: 'Los importes se calculan en servidor. Los pagos de activacion se identifican mediante purpose developer_activation. Solo un pago verificado y completado del usuario puede activar su perfil. El historial financiero no se elimina en cascada.'
}

Table downloads {
  id bigint [pk, increment]
  user_id bigint [not null]
  application_id bigint [not null]
  payment_id bigint [unique]
  promotion_id bigint
  price_paid decimal(12,2) [not null, default: 0]
  store_commission decimal(12,2) [not null, default: 0]
  developer_net decimal(12,2) [not null, default: 0]
  downloaded_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, application_id) [unique, name: 'downloads_user_application_unique']
    (application_id, downloaded_at) [name: 'downloads_application_trends_idx']
    (user_id, downloaded_at) [name: 'downloads_user_history_idx']
    promotion_id [name: 'downloads_promotion_id_idx']
  }

  checks {
    `price_paid >= 0` [name: 'downloads_price_paid_non_negative']
    `store_commission >= 0` [name: 'downloads_commission_non_negative']
    `developer_net >= 0` [name: 'downloads_developer_net_non_negative']
    `price_paid = store_commission + developer_net` [name: 'downloads_amount_breakdown']
    `(price_paid = 0) OR (payment_id IS NOT NULL)` [name: 'downloads_paid_requires_payment']
  }

  Note: 'La descarga conserva importes historicos. La comision sera 3% de price_paid, redondeada a dos decimales. Las aplicaciones gratuitas no requieren PayPal. Los pagos y promociones se validan transaccionalmente.'
}

Table developer_earnings {
  id bigint [pk, increment]
  developer_id bigint [not null]
  download_id bigint [not null, unique]
  gross_amount decimal(12,2) [not null]
  commission_amount decimal(12,2) [not null]
  net_amount decimal(12,2) [not null]
  status earning_status [not null, default: 'pending']
  available_at timestamptz
  paid_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (developer_id, status, available_at) [name: 'developer_earnings_payout_idx']
  }

  checks {
    `gross_amount >= 0` [name: 'developer_earnings_gross_non_negative']
    `commission_amount >= 0` [name: 'developer_earnings_commission_non_negative']
    `net_amount >= 0` [name: 'developer_earnings_net_non_negative']
    `gross_amount = commission_amount + net_amount` [name: 'developer_earnings_amount_breakdown']
    `(status <> 'available') OR (available_at IS NOT NULL)` [name: 'developer_earnings_available_at']
    `(status <> 'paid') OR (paid_at IS NOT NULL)` [name: 'developer_earnings_paid_at']
  }

  Note: 'Los importes se derivan de la descarga y son historicos. developer_id debe coincidir con el propietario de la aplicacion.'
}

Table reviews {
  id bigint [pk, increment]
  user_id bigint [not null]
  application_id bigint [not null]
  rating smallint [not null]
  body text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, application_id) [unique, name: 'reviews_user_application_unique']
    (application_id, rating) [name: 'reviews_application_rating_idx']
  }

  checks {
    `rating BETWEEN 1 AND 5` [name: 'reviews_rating_range']
  }

  Note: 'Solo puede crear una resena un usuario que ya tenga una descarga de la misma aplicacion.'
}

Table review_likes {
  user_id bigint [not null]
  review_id bigint [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, review_id) [pk]
    (review_id, created_at) [name: 'review_likes_review_idx']
  }
}

Table promotions {
  id bigint [pk, increment]
  created_by bigint [not null]
  name varchar(255) [not null]
  code varchar(64) [not null, unique]
  discount_type promotion_discount_type [not null]
  discount_value decimal(12,2) [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  max_redemptions integer
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active, starts_at, ends_at) [name: 'promotions_validity_idx']
    (created_by, created_at) [name: 'promotions_creator_idx']
  }

  checks {
    `code = upper(code)` [name: 'promotions_code_uppercase']
    `starts_at < ends_at` [name: 'promotions_valid_period']
    `max_redemptions IS NULL OR max_redemptions > 0` [name: 'promotions_max_redemptions_positive']
    `(discount_type = 'percentage' AND discount_value > 0 AND discount_value <= 100) OR (discount_type = 'fixed' AND discount_value > 0)` [name: 'promotions_discount_value_range']
  }

  Note: 'created_by corresponde a un usuario admin. El limite global de canjes y vigencia se comprueban transaccionalmente.'
}

Table promotion_applications {
  promotion_id bigint [not null]
  application_id bigint [not null]

  indexes {
    (promotion_id, application_id) [pk]
    application_id [name: 'promotion_applications_application_idx']
  }
}

Table promotion_users {
  promotion_id bigint [not null]
  user_id bigint [not null]
  assigned_at timestamptz [not null, default: `now()`]

  indexes {
    (promotion_id, user_id) [pk]
    (user_id, assigned_at) [name: 'promotion_users_user_idx']
  }
}

Table promotion_redemptions {
  id bigint [pk, increment]
  promotion_id bigint [not null]
  user_id bigint [not null]
  download_id bigint [not null, unique]
  discount_amount decimal(12,2) [not null]
  redeemed_at timestamptz [not null, default: `now()`]

  indexes {
    (promotion_id, user_id, redeemed_at) [name: 'promotion_redemptions_usage_idx']
  }

  checks {
    `discount_amount > 0` [name: 'promotion_redemptions_discount_positive']
  }

  Note: 'El canje corresponde a una promocion vigente, asignada y aplicable a la descarga. La concurrencia se resuelve transaccionalmente.'
}

Table sessions {
  id varchar(255) [pk]
  user_id bigint
  ip_address varchar(45)
  user_agent text
  payload text [not null]
  last_activity integer [not null]

  indexes {
    user_id [name: 'sessions_user_id_idx']
    last_activity [name: 'sessions_last_activity_idx']
  }

  Note: 'Tabla de autenticacion de Laravel.'
}

Table password_reset_tokens {
  email varchar(255) [pk]
  token varchar(255) [not null]
  created_at timestamptz

  Note: 'Tabla de autenticacion de Laravel.'
}

Ref: developer_profiles.user_id > users.id [delete: restrict, update: no action]
Ref: applications.developer_id > developer_profiles.id [delete: restrict, update: no action]
Ref: applications.category_id > categories.id [delete: restrict, update: no action]
Ref: application_screenshots.application_id > applications.id [delete: cascade, update: no action]
Ref: payments.user_id > users.id [delete: restrict, update: no action]
Ref: payments.application_id > applications.id [delete: restrict, update: no action]
Ref: downloads.user_id > users.id [delete: restrict, update: no action]
Ref: downloads.application_id > applications.id [delete: restrict, update: no action]
Ref: downloads.payment_id > payments.id [delete: restrict, update: no action]
Ref: downloads.promotion_id > promotions.id [delete: restrict, update: no action]
Ref: developer_earnings.developer_id > developer_profiles.id [delete: restrict, update: no action]
Ref: developer_earnings.download_id > downloads.id [delete: restrict, update: no action]

Ref: reviews.user_id > users.id [delete: restrict, update: no action]
Ref: reviews.application_id > applications.id [delete: restrict, update: no action]
Ref: review_likes.user_id > users.id [delete: cascade, update: no action]
Ref: review_likes.review_id > reviews.id [delete: cascade, update: no action]

Ref: promotions.created_by > users.id [delete: restrict, update: no action]
Ref: promotion_applications.promotion_id > promotions.id [delete: cascade, update: no action]
Ref: promotion_applications.application_id > applications.id [delete: cascade, update: no action]
Ref: promotion_users.promotion_id > promotions.id [delete: cascade, update: no action]
Ref: promotion_users.user_id > users.id [delete: cascade, update: no action]
Ref: promotion_redemptions.promotion_id > promotions.id [delete: restrict, update: no action]
Ref: promotion_redemptions.user_id > users.id [delete: restrict, update: no action]
Ref: promotion_redemptions.download_id > downloads.id [delete: restrict, update: no action]

Ref: sessions.user_id > users.id [delete: set null, update: no action]

TableGroup identity_and_authentication {
  users
  developer_profiles
  sessions
  password_reset_tokens
}

TableGroup catalog {
  categories
  applications
  application_screenshots
}

TableGroup commerce {
  payments
  downloads
  developer_earnings
}

TableGroup community {
  reviews
  review_likes
}

TableGroup promotions_group {
  promotions
  promotion_applications
  promotion_users
  promotion_redemptions
}
